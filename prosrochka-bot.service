[Unit]
Description=Telegram-bot: ежедневный отчёт по просрочке (MYHAMKOR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prosrochka
WorkingDirectory=/opt/prosrochka_bot
ExecStart=/opt/prosrochka_bot/venv/bin/python /opt/prosrochka_bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
